{
  "version": 1,
  "name": "Orders Mesh",
  "description": "A hand-written map with a non-web layer set: ingress / services / messaging / data / observability. Proves the HUD renders whatever layers a map declares.",
  "root": "C:/example/orders-mesh",
  "generator": { "name": "hand-written", "version": "1" },
  "layers": [
    { "id": "ingress", "label": "Ingress", "description": "Gateways, load balancers, auth at the edge" },
    { "id": "services", "label": "Services", "description": "gRPC / HTTP microservices" },
    { "id": "messaging", "label": "Messaging", "description": "Topics, streams, consumers" },
    { "id": "data", "label": "Data", "description": "Databases and object storage", "color": "#ff8a65" },
    { "id": "observability", "label": "Observability", "description": "Metrics, traces, alerting" }
  ],
  "lanes": [
    { "id": "orders", "label": "Orders", "description": "Order intake and fulfilment" },
    { "id": "payments", "label": "Payments", "description": "Charging and refunds" },
    { "id": "inventory", "label": "Inventory", "description": "Stock levels and reservations" }
  ],
  "nodes": [
    { "id": "gw:api", "label": "API Gateway", "kind": "middleware", "layer": "ingress", "summary": "Envoy; JWT validation, rate limits", "meta": { "listeners": ["0.0.0.0:443"], "rateLimit": "600 rpm per key" } },
    { "id": "gw:webhooks", "label": "Webhook Ingress", "kind": "route", "layer": "ingress", "lane": "payments", "summary": "POST /hooks/psp — signature check", "meta": { "method": "POST", "path": "/hooks/psp" } },

    { "id": "svc:orders", "label": "orders-svc", "kind": "service", "layer": "services", "lane": "orders", "summary": "Order lifecycle (gRPC)", "files": [{ "path": "services/orders/" }] },
    { "id": "fn:orders-create", "label": "CreateOrder()", "kind": "function", "layer": "services", "lane": "orders", "parent": "svc:orders", "summary": "Validates cart, reserves stock, emits OrderPlaced", "meta": { "signature": "CreateOrder(ctx, *CreateOrderRequest) (*Order, error)" } },
    { "id": "fn:orders-cancel", "label": "CancelOrder()", "kind": "function", "layer": "services", "lane": "orders", "parent": "svc:orders", "summary": "Releases stock, requests refund", "meta": { "signature": "CancelOrder(ctx, *CancelOrderRequest) (*Order, error)" } },
    { "id": "svc:fulfilment", "label": "fulfilment-svc", "kind": "service", "layer": "services", "lane": "orders", "summary": "Picks, packs, ships", "files": [{ "path": "services/fulfilment/" }] },
    { "id": "svc:payments", "label": "payments-svc", "kind": "service", "layer": "services", "lane": "payments", "summary": "Charges via the PSP; idempotent by order id", "files": [{ "path": "services/payments/" }] },
    { "id": "fn:charge", "label": "Charge()", "kind": "function", "layer": "services", "lane": "payments", "parent": "svc:payments", "summary": "Creates a PSP charge, records the attempt", "meta": { "signature": "Charge(ctx, orderId string, amount Money) (ChargeResult, error)" } },
    { "id": "fn:refund", "label": "Refund()", "kind": "function", "layer": "services", "lane": "payments", "parent": "svc:payments", "summary": "Full or partial refund" },
    { "id": "svc:inventory", "label": "inventory-svc", "kind": "service", "layer": "services", "lane": "inventory", "summary": "Stock levels, reservations with TTL", "files": [{ "path": "services/inventory/" }] },
    { "id": "job:reservation-expiry", "label": "reservation-expiry", "kind": "job", "layer": "services", "lane": "inventory", "summary": "Every minute: release expired reservations" },

    { "id": "topic:order-events", "label": "order.events", "kind": "queue", "layer": "messaging", "lane": "orders", "summary": "Kafka · 12 partitions · 7d retention", "meta": { "partitions": 12, "retention": "7d" } },
    { "id": "evt:order-placed", "label": "OrderPlaced", "kind": "event", "layer": "messaging", "lane": "orders", "parent": "topic:order-events", "summary": "{orderId, lines[], total}" },
    { "id": "evt:order-cancelled", "label": "OrderCancelled", "kind": "event", "layer": "messaging", "lane": "orders", "parent": "topic:order-events", "summary": "{orderId, reason}" },
    { "id": "topic:payment-events", "label": "payment.events", "kind": "queue", "layer": "messaging", "lane": "payments", "summary": "Kafka · 6 partitions" },
    { "id": "evt:payment-captured", "label": "PaymentCaptured", "kind": "event", "layer": "messaging", "lane": "payments", "parent": "topic:payment-events", "summary": "{orderId, chargeId, amount}" },
    { "id": "evt:payment-failed", "label": "PaymentFailed", "kind": "event", "layer": "messaging", "lane": "payments", "parent": "topic:payment-events", "summary": "{orderId, code}" },
    { "id": "dlq:orders", "label": "order.events.dlq", "kind": "queue", "layer": "messaging", "lane": "orders", "summary": "Dead letters after 5 retries" },

    { "id": "db:orders", "label": "orders-pg", "kind": "store", "layer": "data", "lane": "orders", "summary": "Postgres 16 · primary + 1 replica" },
    { "id": "tbl:orders", "label": "orders", "kind": "table", "layer": "data", "lane": "orders", "parent": "db:orders", "meta": { "columns": [{ "name": "id", "type": "uuid pk" }, { "name": "customer_id", "type": "uuid" }, { "name": "status", "type": "text" }, { "name": "total_cents", "type": "int" }, { "name": "placed_at", "type": "timestamptz" }] } },
    { "id": "tbl:order-lines", "label": "order_lines", "kind": "table", "layer": "data", "lane": "orders", "parent": "db:orders", "meta": { "columns": [{ "name": "order_id", "type": "uuid fk" }, { "name": "sku", "type": "text" }, { "name": "qty", "type": "int" }, { "name": "unit_cents", "type": "int" }] } },
    { "id": "db:payments", "label": "payments-pg", "kind": "store", "layer": "data", "lane": "payments", "summary": "Postgres 16 · PCI segment" },
    { "id": "tbl:charges", "label": "charges", "kind": "table", "layer": "data", "lane": "payments", "parent": "db:payments", "meta": { "columns": [{ "name": "id", "type": "uuid pk" }, { "name": "order_id", "type": "uuid" }, { "name": "psp_ref", "type": "text unique" }, { "name": "state", "type": "text" }] } },
    { "id": "cache:stock", "label": "stock-redis", "kind": "cache", "layer": "data", "lane": "inventory", "summary": "Redis cluster · reservations with TTL" },
    { "id": "bucket:invoices", "label": "invoices-bucket", "kind": "store", "layer": "data", "lane": "payments", "summary": "S3 · PDF invoices" },

    { "id": "obs:metrics", "label": "Prometheus", "kind": "external", "layer": "observability", "summary": "Scrapes every service /metrics" },
    { "id": "obs:traces", "label": "Tempo", "kind": "external", "layer": "observability", "summary": "OTel traces, 14d" },
    { "id": "obs:alerts", "label": "Alert rules", "kind": "config", "layer": "observability", "summary": "payment_failed_rate > 2% · dlq_depth > 0", "meta": { "rules": { "PaymentFailureRate": "rate(payment_failed_total[5m]) > 0.02", "DlqNotEmpty": "kafka_dlq_depth > 0" } } },
    { "id": "ext:psp", "label": "Payment provider", "kind": "external", "layer": "ingress", "lane": "payments", "summary": "Charges, refunds, webhooks" }
  ],
  "edges": [
    { "from": "gw:api", "to": "svc:orders", "kind": "calls", "label": "gRPC" },
    { "from": "gw:api", "to": "svc:inventory", "kind": "calls", "label": "gRPC" },
    { "from": "gw:webhooks", "to": "svc:payments", "kind": "calls", "label": "psp webhook" },
    { "from": "ext:psp", "to": "gw:webhooks", "kind": "calls" },
    { "from": "fn:orders-create", "to": "svc:inventory", "kind": "calls", "label": "Reserve" },
    { "from": "fn:orders-create", "to": "tbl:orders", "kind": "writes" },
    { "from": "fn:orders-create", "to": "tbl:order-lines", "kind": "writes" },
    { "from": "fn:orders-create", "to": "evt:order-placed", "kind": "emits" },
    { "from": "fn:orders-cancel", "to": "tbl:orders", "kind": "writes" },
    { "from": "fn:orders-cancel", "to": "evt:order-cancelled", "kind": "emits" },
    { "from": "svc:payments", "to": "evt:order-placed", "kind": "listens" },
    { "from": "svc:payments", "to": "evt:order-cancelled", "kind": "listens" },
    { "from": "fn:charge", "to": "ext:psp", "kind": "calls" },
    { "from": "fn:charge", "to": "tbl:charges", "kind": "writes" },
    { "from": "fn:charge", "to": "evt:payment-captured", "kind": "emits" },
    { "from": "fn:charge", "to": "evt:payment-failed", "kind": "emits" },
    { "from": "fn:refund", "to": "ext:psp", "kind": "calls" },
    { "from": "fn:refund", "to": "tbl:charges", "kind": "writes" },
    { "from": "svc:fulfilment", "to": "evt:payment-captured", "kind": "listens" },
    { "from": "svc:fulfilment", "to": "tbl:orders", "kind": "writes", "label": "status" },
    { "from": "svc:fulfilment", "to": "bucket:invoices", "kind": "writes", "label": "invoice.pdf" },
    { "from": "svc:inventory", "to": "cache:stock", "kind": "writes" },
    { "from": "svc:inventory", "to": "cache:stock", "kind": "reads" },
    { "from": "job:reservation-expiry", "to": "cache:stock", "kind": "writes" },
    { "from": "svc:orders", "to": "evt:payment-failed", "kind": "listens" },
    { "from": "topic:order-events", "to": "dlq:orders", "kind": "emits", "label": "after 5 retries" },
    { "from": "obs:metrics", "to": "svc:orders", "kind": "reads", "label": "/metrics" },
    { "from": "obs:metrics", "to": "svc:payments", "kind": "reads", "label": "/metrics" },
    { "from": "obs:metrics", "to": "svc:inventory", "kind": "reads", "label": "/metrics" },
    { "from": "svc:orders", "to": "obs:traces", "kind": "emits", "label": "otel" },
    { "from": "svc:payments", "to": "obs:traces", "kind": "emits", "label": "otel" },
    { "from": "obs:alerts", "to": "obs:metrics", "kind": "reads" },
    { "from": "obs:alerts", "to": "dlq:orders", "kind": "reads", "label": "depth" }
  ]
}
